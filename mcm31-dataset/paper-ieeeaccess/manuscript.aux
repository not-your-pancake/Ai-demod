\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Symbol error rate against SNR for the learned and classical reference receivers on the same leave-one-pattern-out test records, as the unweighted mean over folds. SNR is the per-sample ratio of \eqref  {eq:noise}; $E_s/N_0 = \mathrm  {SNR} + 10$~dB. Learned: mean of three training seeds, with bars spanning the seeds. Classical: mean of five noise realisations. Hollow triangles mark operating points at which no error was observed in any run. They are drawn on a fixed floor line at $1.5\times 10^{-6}$, a plotting convention below every non-zero mean, not a confidence bound.}}{11}{}\protected@file@percent }
\newlabel{fig:ser}{{4}{11}{}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Symbol error rate, learned (L) and classical reference (C) receivers, on the same leave-one-pattern-out test records, as the unweighted mean over folds. L is the mean of three training seeds; C is the mean of five noise realisations. A dash means no error was observed in any run; $<\!10^{-4}$ marks rates that are non-zero but below the last digit shown.}}{11}{}\protected@file@percent }
\newlabel{tab:ser}{{8}{11}{}{table.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 8-QAM symbol error rate by evaluation split, as the unweighted mean over folds. Bars span three training seeds; for the random split they span seven runs (three seeds on the main partition and four further partitions). The dash-dot lines are leave-one-board-out without board B5 and leave-one-pattern-out without the T1+T2 fold, which trains on four records.}}{11}{}\protected@file@percent }
\newlabel{fig:splits}{{5}{11}{}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces 8-QAM symbol error rate by evaluation split, as the unweighted mean over folds, mean $\pm $ standard deviation over runs. \emph  {Runs}: training seeds, or for the random split seeds and partitions. Leave-one-attenuation-out has one seed. T3--T6 are the leave-one-pattern-out folds that train on fourteen records.}}{12}{}\protected@file@percent }
\newlabel{tab:splits}{{9}{12}{}{table.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-B}}Generalisation}{12}{}\protected@file@percent }
\newlabel{sec:generalisation}{{\mbox  {VI-B}}{12}{}{subsection.6.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-C}}Negative controls}{12}{}\protected@file@percent }
\newlabel{sec:controls}{{\mbox  {VI-C}}{12}{}{subsection.6.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Per-fold results, training seed~0. \emph  {Train records} is the number of records in the training partition; the two folds with fewer than three are the thin folds discussed in the text. \emph  {Test symbols} counts evaluated windows, after the edge trimming of Section~\ref {sec:conditioning}. The S1, Q2, Q3 and T3--T6 folds each test a single record from board B1. \emph  {Position-only} is a lookup from a symbol's index within the data word to its most frequent training label, against chance levels of $0.500$, $0.750$ and $0.875$. It is a meaningful control only where the withheld word is absent from training. Every leave-one-board-out fold reuses the training word, so position then determines the label exactly, and the entry is marked {\it  n/a} (Section~\ref {sec:controls}). }}{13}{}\protected@file@percent }
\newlabel{tab:perfold}{{10}{13}{}{table.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Controls on the leave-one-pattern-out folds, as the unweighted mean over folds. \emph  {Shuffled}: training labels permuted, test labels as measured; mean over five permutation seeds, with the range of the five fold-means in brackets. \emph  {Position-only}: the lookup of the text, with its cyclic-shift null mean in brackets. \emph  {Context-only}: a lookup from the true labels of the window's neighbouring symbols to the target label. Model: learned receiver at $6$~dB, mean of three seeds. Chance is $1-1/K$.}}{13}{}\protected@file@percent }
\newlabel{tab:controls}{{11}{13}{}{table.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-D}}Constellation geometry}{13}{}\protected@file@percent }
\newlabel{sec:geometry}{{\mbox  {VI-D}}{13}{}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Controls on the leave-one-pattern-out folds. Learned receiver at $6$~dB, mean of three seeds. Position-only lookup. Shuffled training labels, mean of five permutation seeds, with bars spanning the five fold-means. Dotted lines mark the nominal chance level $1-1/K$; the spread of the shuffled control is discussed in the text.}}{14}{}\protected@file@percent }
\newlabel{fig:controls}{{6}{14}{}{figure.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Ablation of the constellation term of \eqref  {eq:loss}. One leave-one-board-out fold (B2 withheld), 18 epochs, one seed; the main results use $\lambda = 0.2$ and 25 epochs.}}{14}{}\protected@file@percent }
\newlabel{tab:ablation}{{12}{14}{}{table.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-E}}Empirical Performance of the On-Board Demodulators}{14}{}\protected@file@percent }
\newlabel{sec:hardware}{{\mbox  {VI-E}}{14}{}{subsection.6.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Destination of 8-QAM errors at $0$~dB. The figure comes from a separate training run with board B2 withheld (leave-one-board-out, $18$ epochs, $\lambda = 0.2$, seed~0), with one noise realisation: $863$ errors among $7{,}192$ test symbols. Left: confusions drawn on the unit-RMS reference constellation, with line width proportional to count. Each line combines both directions of a confusion; the two directions differ by $9.6\%$ of all errors in total. Pairs with fewer than five confusions are not drawn. Right: share of errors against inter-point distance, compared with a null in which every wrong class is equally likely.}}{15}{}\protected@file@percent }
\newlabel{fig:geometry}{{7}{15}{}{figure.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {VII}Discussion}{15}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Behaviour of the boards' own BPSK demodulators on the PRBS63 word, across five boards: agreement of TP-9 with the transmitted sequence against TP-20 output level. The shaded band is the chance region up to the 95th percentile of the null ($69.8\%$), from the best agreement over 63 cyclic shifts and both polarities. Records at or below $509$~mV are consistent with chance; records at or above $626$~mV agree at $92$--$100\%$. No record falls between the two levels.}}{15}{}\protected@file@percent }
\newlabel{fig:lock}{{8}{15}{}{figure.8}{}}
